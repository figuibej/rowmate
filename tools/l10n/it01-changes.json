{
  "description": "Cambios de la It. 1 sobre lib/l10n/app_{es,en}.arb del legacy. Fuente: 01-po-spec §4.17.1 (4 claves que cambian, Q-02) y §4.17.2 (15 claves nuevas, Q-01 + Q-02); tipos de los parámetros: 02-tech-design §3.3 (QA-07). Lo aplica tools/l10n/arb_to_catalog.dart una sola vez; después los catálogos se mantienen a mano (ADR 011).",
  "changed": [
    {
      "key": "workoutStartTitle",
      "es": { "from": "Iniciar entrenamiento?", "to": "¿Iniciar entrenamiento?" }
    },
    {
      "key": "workoutStartContent",
      "es": { "from": "{summary}\n\nIniciar el entrenamiento?", "to": "{summary}\n\n¿Iniciar el entrenamiento?" }
    },
    {
      "key": "profileSyncResult",
      "es": { "from": "{count} sesiones sincronizadas", "to": "{count, plural, one{# sesión sincronizada} other{# sesiones sincronizadas}}" },
      "en": { "from": "{count} sessions synced", "to": "{count, plural, one{# session synced} other{# sessions synced}}" }
    },
    {
      "key": "profileUploadResult",
      "es": { "from": "{count} sesiones subidas", "to": "{count, plural, one{# sesión subida} other{# sesiones subidas}}" },
      "en": { "from": "{count} sessions uploaded", "to": "{count, plural, one{# session uploaded} other{# sessions uploaded}}" }
    }
  ],
  "added": [
    {
      "key": "routineSummarySteps",
      "es": "{count, plural, one{# paso} other{# pasos}}",
