<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>RowMate.App</AssemblyName>
    <RootNamespace>RowMate.App</RootNamespace>
    <RowMateAsmdef>App/RowMate.App.asmdef</RowMateAsmdef>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityAssets)App/**/*.cs" LinkBase="App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RowMate.Core/RowMate.Core.csproj" />
  </ItemGroup>
</Project>
