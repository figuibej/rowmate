<?xml version="1.0" encoding="UTF-8"?>
<!-- Arranque de iOS de RowMate (It. 14, 14-pulido-plataformas/02-tech-design DT14-09; AC-APP-16-11): fondo bg.app #0D1B2A y la
     marca RowMateLaunchMark de 96 pt centrada, en claro y en oscuro. La imagen la copia Editor/Build/ApplePostprocess al catálogo
     de Xcode. Sin textos. [Apple] NO VERIFICABLE hasta la 10b. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="21701" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="RMLaunchVC">
    <device id="retina6_1" orientation="portrait" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21679"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="RMLaunchScene">
            <objects>
                <viewController id="RMLaunchVC" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="RMLaunchView">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="RowMateLaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="RMLaunchMark">
                                <rect key="frame" x="159" y="400" width="96" height="96"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="96" id="RMMarkWidth"/>
                                    <constraint firstAttribute="height" constant="96" id="RMMarkHeight"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.050980392156862744" green="0.10588235294117647" blue="0.16470588235294117" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="RMLaunchMark" firstAttribute="centerX" secondItem="RMLaunchView" secondAttribute="centerX" id="RMMarkCenterX"/>
                            <constraint firstItem="RMLaunchMark" firstAttribute="centerY" secondItem="RMLaunchView" secondAttribute="centerY" id="RMMarkCenterY"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="RMFirstResponder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
    </scenes>
    <resources>
        <image name="RowMateLaunchMark" width="96" height="96"/>
    </resources>
</document>
