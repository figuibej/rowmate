/* Dueño: WP-D (Designer). Aspecto de la app sobre las clases de contrato de 02-tech-design §3.12 ("Lo que es de WP-D"):
   capas de estado (hover y presionado), botón tonal, anillo y halo de foco por control, brillos y vidrio de la barra.
   Fuente: 04-design-notes de la It. 2, §4.1-§4.7 y §4.10 (y §15, lo que cambió al implementarlo); desde la It. 3, también
   03-rutinas/04-design-notes §4, §5.9 y §16 y el contrato de 03-rutinas/02-tech-design §7.5 (al final). No cambia las
   propiedades de contrato (las verifican los tests PlayMode): fondos, radios de tarjeta, bordes superiores, tamaños de
   ícono, alturas mínimas, colores de texto de contrato.
   Reglas: ningún color literal (solo var(--rm-…)); los "blanco al N %" son la capa blanca de Base.uss con opacity; ningún
   font-size ni -unity-font-definition en elementos con .rm-type-*. USS no tiene :not(): las excepciones (el elegido, lo
   deshabilitado) van con una regla más específica después. Las escalas al presionar y todas las transiciones están en
   Motion.uss.
   Presionado = :hover:active (puntero o dedo apoyado sobre el control). Un :active solo es el "clic simulado" de UI Toolkit
   (Enter/Espacio o NavigationSubmitEvent: :active durante 100 ms de reloj real): con teclado manda el anillo de foco, y así
   el arnés de capturas, que toca con NavigationSubmitEvent y un reloj de prueba, no fotografía un "presionado" a medias. */

/* ── Brillos (DN-06; §4.2 y §4.4): la textura VerticalFade (por código) estirada a la caja; tinte y alto en Base.uss ── */
.rm-card__glow,
.rm-tab-bar__sheen {
    -unity-background-scale-mode: stretch-to-fill;
}

/* ── Barra de pestañas de vidrio (§4.2) ───────────────────────────────────────────────────────────────────────────── */
/* Hover solo en escritorio y solo en los no elegidos: capa blanca al 4 %. */
.rm-desktop .rm-tab:hover .rm-tab__state {
    opacity: 0.04;
}

.rm-desktop .rm-tab--selected:hover .rm-tab__state {
    opacity: 0;
}

/* Presionado: capa al 8 % (la caja del ícono además escala a 0,94: Motion.uss). */
.rm-tab:hover:active .rm-tab__state,
.rm-desktop .rm-tab:hover:active .rm-tab__state,
.rm-desktop .rm-tab--selected:hover:active .rm-tab__state {
    opacity: 0.08;
}

/* Anillo alrededor de la caja del ícono (56 × 32, r.full): radio 16 + 4; halo + 4. */
.rm-tab .rm-focus-ring {
    border-radius: 20px;
}

.rm-tab .rm-focus-ring__halo {
    border-radius: 24px;
}

/* ── Botones y controles accionables (§4.7) ───────────────────────────────────────────────────────────────────────
   Capa .rm-button__state (blanca, Base.uss): hover 4 % (solo escritorio), presionado 8 %. Vale para los botones
   (RmButton), los de ícono, los chips, las filas de sensores y la llave del simulador. */
.rm-desktop .rm-button:hover > .rm-button__state,
.rm-desktop .rm-icon-button:hover > .rm-button__state,
.rm-desktop .rm-chip:hover > .rm-button__state,
.rm-desktop .rm-hrm-device-row:hover > .rm-button__state,
.rm-desktop .rm-sim-fab:hover > .rm-button__state {
    opacity: 0.04;
}

.rm-button:hover:active > .rm-button__state,
.rm-icon-button:hover:active > .rm-button__state,
.rm-chip:hover:active > .rm-button__state,
.rm-hrm-device-row:hover:active > .rm-button__state,
.rm-sim-fab:hover:active > .rm-button__state,
.rm-desktop .rm-button:hover:active > .rm-button__state,
.rm-desktop .rm-icon-button:hover:active > .rm-button__state,
.rm-desktop .rm-chip:hover:active > .rm-button__state,
.rm-desktop .rm-hrm-device-row:hover:active > .rm-button__state,
.rm-desktop .rm-sim-fab:hover:active > .rm-button__state {
    opacity: 0.08;
}

/* Primario: presionado = fondo accent.primaryPressed (sin capa encima). Base.uss lo pone también con :active solo (el clic
   simulado de 100 ms); acá queda solo con el puntero apoyado, como el resto. */
.rm-button--primary:active {
    background-color: var(--rm-accent-primary);
}

.rm-button--primary:hover:active {
    background-color: var(--rm-accent-primary-pressed);
}

.rm-button--primary:hover:active > .rm-button__state,
.rm-desktop .rm-button--primary:hover:active > .rm-button__state {
    opacity: 0;
}

/* Deshabilitado (contrato: opacidad 0,38 en todo el control): sin hover ni presión. */
.rm-button:disabled > .rm-button__state,
.rm-icon-button:disabled > .rm-button__state,
.rm-chip:disabled > .rm-button__state,
.rm-hrm-device-row:disabled > .rm-button__state,
.rm-desktop .rm-button:hover:disabled > .rm-button__state,
.rm-desktop .rm-icon-button:hover:disabled > .rm-button__state,
.rm-desktop .rm-chip:hover:disabled > .rm-button__state,
.rm-desktop .rm-hrm-device-row:hover:disabled > .rm-button__state,
.rm-desktop .rm-button:hover:active:disabled > .rm-button__state,
.rm-desktop .rm-icon-button:hover:active:disabled > .rm-button__state,
.rm-desktop .rm-chip:hover:active:disabled > .rm-button__state,
.rm-desktop .rm-hrm-device-row:hover:active:disabled > .rm-button__state {
    opacity: 0;
}

/* Tonal (hrm-search en "Sin sensor", hrm-retry): accent.tonalBg con accent.onTonal (N3: 5,88 en reposo, 5,24 con hover).
   Mismos selectores que Base.uss para ganarle con la misma especificidad. */
.rm-button--tonal,
.rm-button--tonal:hover,
.rm-button--tonal:active,
.rm-button--tonal:focus,
.rm-button--tonal:hover:active,
.rm-button--tonal:disabled,
.rm-button--tonal:disabled:hover {
    background-color: var(--rm-accent-tonal-bg);
}

.rm-button--tonal .rm-button__label,
.rm-button--tonal .rm-icon {
    color: var(--rm-accent-on-tonal);
}

/* Anillo de foco por control: radio = radio del control + 4 y halo + 4 (Base.uss: botón r.l 12 → 16 / 20). */
.rm-icon-button > .rm-focus-ring {
    border-radius: 28px;
}

.rm-icon-button > .rm-focus-ring > .rm-focus-ring__halo {
    border-radius: 32px;
}

.rm-chip > .rm-focus-ring {
    border-radius: 12px;
}

.rm-chip > .rm-focus-ring > .rm-focus-ring__halo {
    border-radius: 16px;
}

/* La capa de la fila se extiende 8 dp a cada lado del texto (Base.uss): el anillo la rodea. */
.rm-hrm-device-row > .rm-focus-ring {
    left: -12px;
    right: -12px;
    border-radius: 12px;
}

.rm-hrm-device-row > .rm-focus-ring > .rm-focus-ring__halo {
    border-radius: 16px;
}

/* ── Interruptor (DN-17): anillo alrededor del renglón, con el radio de los botones ── */
.rm-switch-row > .rm-focus-ring {
    left: -8px;
    right: -8px;
}

/* ════ It. 3 — Rutinas, editor, diálogos, menús y campos (03-rutinas/04-design-notes §4, §5.9 y §16) ════
   Lo mismo que arriba: hover 4 % solo en escritorio, presionado = :hover:active (puntero o dedo apoyado) y nunca :active
   solo, que el arnés deja 100 ms de reloj real al tocar con NavigationSubmitEvent. Geometría, fondos, bordes y colores de
   contrato están en Base.uss (WP-B); acá van las capas de estado, los anillos que faltaban y los ajustes de lectura que
   salieron de mirar las capturas (04-design-notes §16.2: fila de 56, texto del campo en la columna de la etiqueta, aire en
   el diálogo que se desplaza). */

/* Tarjeta de rutina (§4.2): capa común r.card, hover 4 %, presionado 8 %, sin escala (superficie grande). El resaltado de lo
   editado es otra capa (.rm-highlight, por código), así el hover nunca la pisa. */
.rm-desktop .rm-routine-card:hover > .rm-button__state {
    opacity: 0.04;
}

.rm-routine-card:hover:active > .rm-button__state,
.rm-desktop .rm-routine-card:hover:active > .rm-button__state {
    opacity: 0.08;
}

/* Botón flotante + (§4.1): hover 4 %; presionado = fondo accent.primaryPressed sin capa, como el primario (la escala 0,94 está
   en Motion.uss). Base.uss pone el fondo presionado también con :active solo: acá queda solo con el puntero apoyado. */
.rm-fab:active {
    background-color: var(--rm-accent-primary);
}

.rm-fab:hover:active {
    background-color: var(--rm-accent-primary-pressed);
}

.rm-desktop .rm-fab:hover > .rm-button__state {
    opacity: 0.04;
}

.rm-fab:hover:active > .rm-button__state,
.rm-desktop .rm-fab:hover:active > .rm-button__state {
    opacity: 0;
}

/* Chip ×N (§4.7, DN3-04): la capa vive en la cápsula, no en la caja táctil de 48 (las reglas de .rm-chip de arriba miran
   solo un hijo directo). Hover 4 % (accent.onTonal 5,030:1), presionado 8 %; la escala 0,97 de .rm-chip en Motion.uss
   achica la caja transparente con la cápsula centrada adentro, que es lo mismo que achicar la cápsula. */
.rm-desktop .rm-chip--repeat:hover .rm-chip__pill > .rm-button__state {
    opacity: 0.04;
}

.rm-chip--repeat:hover:active .rm-chip__pill > .rm-button__state,
.rm-desktop .rm-chip--repeat:hover:active .rm-chip__pill > .rm-button__state {
    opacity: 0.08;
}

/* Selectores (§4.11). Tiempo / distancia: capa sin radio (la cápsula recorta con overflow), hover 4 %, presionado 8 %, sin
   escala. Mosaicos de tipo: capa r.s 6 (adentro del borde de 2), hover 4 %, presionado 8 % y escala 0,97 (Motion.uss); el
   fondo y el borde del elegido los pinta el código y no tienen transición. */
.rm-segmented .rm-segmented__option > .rm-button__state {
    border-radius: 0;
}

.rm-segmented--tiles .rm-segmented__option > .rm-button__state {
    border-radius: 6px;
}

.rm-desktop .rm-segmented .rm-segmented__option:hover > .rm-button__state {
    opacity: 0.04;
}

.rm-segmented .rm-segmented__option:hover:active > .rm-button__state,
.rm-desktop .rm-segmented .rm-segmented__option:hover:active > .rm-button__state {
    opacity: 0.08;
}

/* Anillo de la opción de tiempo / distancia (§4.14, cambio de WP-D): la cápsula recorta lo que sale de ella (overflow
   hidden), así que el anillo va ADENTRO, a 2 dp del borde, con las esquinas de afuera redondeadas (19 − 2 = 17) y las del
   divisor casi rectas; sin halo. Sobre la opción elegida (brand.seed) el anillo es blanco: focus.ring daría 1,9:1 y el
   blanco da 4,868:1 (R24); sobre la no elegida, focus.ring sobre surface.overlay da 5,071:1 (R27). Solo hay dos opciones:
   la primera no lleva --divided y la segunda sí. */
.rm-segmented .rm-segmented__option > .rm-focus-ring {
    left: 2px;
    top: 2px;
    right: 2px;
    bottom: 2px;
    border-top-left-radius: 17px;
    border-bottom-left-radius: 17px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}

.rm-segmented .rm-segmented__option--divided > .rm-focus-ring {
    border-top-left-radius: 2px;
    border-bottom-left-radius: 2px;
    border-top-right-radius: 17px;
    border-bottom-right-radius: 17px;
}

.rm-segmented .rm-segmented__option > .rm-focus-ring > .rm-focus-ring__halo {
    display: none;
}

.rm-segmented .rm-segmented__option--selected > .rm-focus-ring {
    border-color: var(--rm-text-primary);
}

/* Anillo del mosaico (§4.14): radio del mosaico + 4 (12) y halo + 4 (16), por fuera. El mosaico tiene borde de 2 y lo
   absoluto se mide desde adentro del borde: −6 deja el anillo a 4 dp del borde de afuera, con los 2 dp de aire de los demás
   controles. Va después de las reglas del segmentado para ganarles con la misma especificidad. */
.rm-segmented--tiles .rm-segmented__option > .rm-focus-ring {
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    border-radius: 12px;
}

.rm-segmented--tiles .rm-segmented__option > .rm-focus-ring > .rm-focus-ring__halo {
    display: flex;
    border-radius: 16px;
}

.rm-segmented--tiles .rm-segmented__option--selected > .rm-focus-ring {
    border-color: var(--rm-focus-ring);
}

/* Menús (§4.4, DN3-11): ítem común con capa blanca, hover 4 % (11,093:1), presionado 8 % (9,802); ítem de peligro con su
   capa OSCURA (overlay.scrim, Base.uss), hover 12 % (5,147:1, R25) y presionado 24 % (5,603): con la blanca daría 4,174. */
.rm-desktop .rm-menu__item:hover > .rm-button__state {
    opacity: 0.04;
}

.rm-menu__item:hover:active > .rm-button__state,
.rm-desktop .rm-menu__item:hover:active > .rm-button__state {
    opacity: 0.08;
}

.rm-desktop .rm-menu__item--danger:hover > .rm-button__state {
    opacity: 0.12;
}

.rm-menu__item--danger:hover:active > .rm-button__state,
.rm-desktop .rm-menu__item--danger:hover:active > .rm-button__state {
    opacity: 0.24;
}

/* Campos (§4.8, DN3-09): hover en escritorio = borde text.tertiary (54 %); con foco o con error manda su borde, también con
   el puntero encima (no dependen de :hover). */
.rm-desktop .rm-field__box:hover {
    border-color: var(--rm-text-tertiary);
}

.rm-desktop .rm-field--focused .rm-field__box:hover {
    border-color: var(--rm-accent-primary);
}

.rm-desktop .rm-field--error .rm-field__box:hover {
    border-color: var(--rm-state-danger);
}

/* Texto y etiqueta alineados (§4.8, cambio de WP-D): el TextElement interno del campo de UI Toolkit trae un margen propio que
   corre el texto ≈ 2 dp a la derecha de la etiqueta (medido en CAP-10 y CAP-13: la etiqueta a 13 dp del borde de afuera y el
   valor a 15). Sin ese margen la etiqueta flotante, la ayuda, la selección y el texto empiezan en la misma columna, como en
   el legacy. Una línea y multilínea. */
.rm-field .rm-field__input .unity-text-element--inner-input-field-component,
.rm-field .rm-field__input .unity-base-text-field__input--single-line > .unity-text-element {
    margin-left: 0;
    padding-left: 0;
}

/* Fila de paso (§4.6, cambio de WP-D): relleno vertical 4. Con 8 arriba y 8 abajo, las cajas táctiles de 48 del lápiz y la
   cruz dejaban cada fila en 64 y la vista previa del diálogo (sin botones) en 56. Con 4 las dos miden 56, el alto del
   contrato (min-height), y el subtítulo en dos líneas lleva la fila a 57 (era 65). */
.rm-step-row {
    padding-top: 4px;
    padding-bottom: 4px;
}

/* Diálogos (§4.9, cambio de WP-D): mientras el contenido se desplaza (líneas finas arriba y abajo), 8 dp de aire entre la
   línea y lo primero o lo último del contenido; sin esto la vista previa de CAP-23 y el último campo de CAP-15b tocaban la
   línea. Sin desplazamiento, el contenido queda pegado al título como en M3 (16 del relleno del título). */
.rm-dialog__content--scrolls .rm-dialog__content-body {
    padding-top: 8px;
    padding-bottom: 8px;
}

/* ════ It. 4a — Workout y el HUD (04a-motor-hud-funcional/04-design-notes §4.1, §4.6 y §5.12) ════
   Workout en reposo usa lo de arriba sin cambios: Entrenamiento libre es el primario (presionado accent.primaryPressed,
   anillo 16 / halo 20), Reintentar el tonal y la tarjeta con chevron la de Rutinas (capa 4 / 8 %, sin escala, anillo 20 / halo
   24; el chevron no cambia de color: W3, 4,785:1 con el hover). Acá, lo propio de los controles del HUD, que van sobre el
   vidrio y la escena: Pausa y Reanudar con la capa blanca de siempre (4 % y 8 %: H4 11,944 y H5 10,172 / 10,367:1). */

/* Terminar: capa OSCURA (overlay.scrim), hover 12 % y presionado 24 % (H2: 5,483 y 5,892:1). Con la capa blanca del 4 % el
   texto state.dangerText bajaba a 4,494:1 sobre el peor vidrio (§9.2), igual que el ítem de peligro de los menús (It. 3). */
.rm-button--hud-danger > .rm-button__state {
    background-color: var(--rm-overlay-scrim);
}

.rm-desktop .rm-button--hud-danger:hover > .rm-button__state {
    opacity: 0.12;
}

.rm-button--hud-danger:hover:active > .rm-button__state,
.rm-desktop .rm-button--hud-danger:hover:active > .rm-button__state {
    opacity: 0.24;
}

/* Terminar y Pausa llevan contorno de 1,5: la capa (absoluta, adentro del borde) sigue la curva de adentro, 12 − 1,5. */
.rm-button--hud-danger > .rm-button__state,
.rm-button--hud-outline > .rm-button__state {
    border-radius: 10.5px;
}

/* Anillo de foco del HUD (DN4a-10, H17): blanco de 2 dp a −4 del borde de afuera del control (radio 12 + 4 = 16) con un halo
   overlay.scrim al 50 % de 4 dp pegado por fuera (radio 20): 3,977:1 contra su halo y el halo contra una nube blanca, sobre
   cualquier fondo de la escena. El cian de la app daba 2,465:1 sobre una nube. Solo navegando con teclado, sin animación
   (las reglas de display son las de Base.uss). Con el contorno de 1,5 de Terminar y Pausa, lo absoluto se mide desde adentro
   del borde: −5,5 deja el anillo a 4 dp del borde de afuera. */
.rm-hud .rm-button > .rm-focus-ring {
    border-color: var(--rm-text-primary);
}

.rm-hud .rm-button > .rm-focus-ring > .rm-focus-ring__halo {
    border-color: var(--rm-overlay-scrim);
    opacity: 0.5;
}

.rm-hud .rm-button--hud-danger > .rm-focus-ring,
.rm-hud .rm-button--hud-outline > .rm-focus-ring {
    left: -5.5px;
    top: -5.5px;
    right: -5.5px;
    bottom: -5.5px;
}

/* ════ It. 4b — El HUD EXR (04b-hud-exr/04-design-notes §2.2, §3.8 y §11; contrato de 04b-hud-exr/02-tech-design §7.5) ════
   Casi todo lo de la 4b lo dibuja y lo mueve el código: las píldoras, el halo, el pulgar, el sello, la cuenta grande y PAUSA
   en su disco, el chip, el velo y el check del diálogo (tamaños, colores con transparencia y escalas por código, porque USS
   no tiene em ni baseline). Terminar del diálogo de completado (#completion-finish) es el primario de la app y toma de arriba
   su capa, su presionado (accent.primaryPressed) y su anillo de foco 16 / 20, sin reglas nuevas.
   Lo de acá salió de mirar las capturas de it4b (04-design-notes, "Cambios por implementación de WP-D2"): */

/* El diálogo de completado (§3.8): esconde el título de la It. 3 y pone su encabezado (el check de 32, 12 de aire y el título)
   en el bloque fijo, que en la It. 3 iba DEBAJO del título y por eso no tiene relleno arriba. Sin esto el check y el título
   quedaban a 1 dp del borde de arriba del diálogo (CAP-07, -09, -11) y había 28 dp hasta el mensaje en lugar de 12 (el
   encabezado ya trae sus 12 por código). Arriba va el relleno del diálogo, 24 (16 con la ventana de menos de 480 dp de
   alto), y de la caja de totales a Terminar quedan 20 (§3.8; el contrato de §7.5: "12 hasta el contenido", "20 hasta las
   acciones"). Con eso el diálogo mide lo de las notas (TV 40,0-371,0 × 298,0-616,0 ± 1; TH 63,2-347,8; W1280 209,7-510,3). */
.rm-dialog--completion .rm-dialog__pinned {
    padding-top: 24px;
    padding-bottom: 0;
}

.rm-dialog--compact.rm-dialog--completion .rm-dialog__pinned {
    padding-top: 16px;
    padding-bottom: 0;
}

.rm-dialog--completion .rm-dialog__actions,
.rm-dialog--compact.rm-dialog--completion .rm-dialog__actions {
    padding-top: 20px;
}
