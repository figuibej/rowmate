/* GENERADO por tools/tokens desde Assets/RowMate/Core/Design/Tokens.cs (TypographyUssWriter). NO EDITAR A MANO (ADR 016). */

:root {
    -unity-font-definition: url("project://database/Assets/RowMate/UI/Fonts/Generated/Inter-Regular-SDF.asset");
}

.rm-icon {
    -unity-font-definition: url("project://database/Assets/RowMate/UI/Icons/Generated/RowMateIcons-Outline-SDF.asset");
    -unity-text-align: middle-center;
    white-space: nowrap;
    letter-spacing: 0;
}

.rm-icon--filled {
    -unity-font-definition: url("project://database/Assets/RowMate/UI/Icons/Generated/RowMateIcons-Filled-SDF.asset");
}

.rm-type-body {
    font-size: 15px;
