/* GENERADO por tools/tokens desde Assets/RowMate/Core/Design/Tokens.cs. NO EDITAR A MANO (ADR 016). */
:root {
    --rm-accent-on-tonal: #38CBEF;
    --rm-accent-primary: #00B4D8;
    --rm-accent-primary-pressed: #0096B4;
    --rm-accent-tonal-bg: rgba(0, 180, 216, 0.12);
    --rm-backdrop-sky: #0B4FA8;
    --rm-backdrop-water: #0E4F8F;
    --rm-bg-app: #0D1B2A;
    --rm-bg-sunken: #08131F;
    --rm-body-size: 15px;
    --rm-body-m-size: 14px;
    --rm-body-s-size: 13px;
    --rm-body-xs-size: 12px;
    --rm-border-default: rgba(255, 255, 255, 0.12);
    --rm-border-input: rgba(255, 255, 255, 0.4);
    --rm-border-strong: rgba(255, 255, 255, 0.24);
    --rm-border-subtle: rgba(255, 255, 255, 0.08);
    --rm-brand-seed: #0077B6;
    --rm-brand-strava: #FC4C02;
    --rm-button-size: 14px;
    --rm-button-s-size: 12px;
    --rm-caption-size: 11px;
    --rm-dev-ble-debug: #18FFFF;
    --rm-dev-ble-debug-bg: rgba(0, 0, 0, 0.38);
    --rm-dev-simulator: #FF5722;
    --rm-dev-simulator-text: #1A0A00;
    --rm-display-size: 32px;
    --rm-dur-base: 240ms;
    --rm-dur-cinematic: 1600ms;
    --rm-dur-fast: 160ms;
    --rm-dur-micro: 90ms;
    --rm-dur-page: 420ms;
    --rm-dur-scene: 900ms;
    --rm-dur-slow: 360ms;
    --rm-ease-emphasis: ease-out-back;
    --rm-ease-enter: ease-out-cubic;
    --rm-ease-exit: ease-in-cubic;
    --rm-ease-linear: linear;
    --rm-ease-move: ease-in-out-cubic;
    --rm-ease-pulse: ease-in-out-sine;
    --rm-focus-ring: #00B4D8;
    --rm-focus-ring-halo: rgba(0, 180, 216, 0.3);
    --rm-glass-fallback: rgba(7, 13, 22, 0.86);
    --rm-header-s-size: 13px;
    --rm-headline-size: 24px;
    --rm-label-size: 12px;
    --rm-metric-distance: #4CC9F0;
    --rm-metric-distance-hud: #4ECBF2;
    --rm-metric-hr: #EF476F;
    --rm-metric-hr-hud: #FF5D7F;
    --rm-metric-kcal: #06D6A0;
    --rm-metric-kcal-hud: #06D6A0;
    --rm-metric-split: #FF9F1C;
    --rm-metric-split-hud: #FFAA47;
    --rm-metric-spm: #00B4D8;
    --rm-metric-spm-hud: #3ACCF1;
    --rm-metric-time: #E0E0E0;
    --rm-metric-time-hud: #E0E0E0;
    --rm-metric-watts: #FFD60A;
    --rm-metric-watts-hud: #FFD60A;
    --rm-nav-indicator: rgba(0, 180, 216, 0.18);
    --rm-num-band-size: 34px;
    --rm-num-hero-size: 64px;
    --rm-num-l-size: 44px;
    --rm-num-lap-size: 34px;
    --rm-num-m-size: 32px;
    --rm-num-row-size: 24px;
    --rm-num-s-size: 20px;
    --rm-num-stat-size: 16px;
    --rm-num-xl-size: 52px;
    --rm-overlay-scrim: #000000;
    --rm-phase-finished: #EF476F;
    --rm-phase-finished-hud: #FF7A92;
    --rm-phase-paused: #FFD166;
    --rm-phase-running: #06D6A0;
    --rm-r-card: 16px;
    --rm-r-full: 999px;
    --rm-r-glass: 14px;
    --rm-r-l: 12px;
    --rm-r-m: 8px;
    --rm-r-s: 6px;
    --rm-r-xs: 4px;
    --rm-shift-l: 16px;
    --rm-shift-m: 12px;
    --rm-shift-s: 8px;
    --rm-shift-xl: 24px;
    --rm-space-dp12: 12px;
    --rm-space-dp16: 16px;
    --rm-space-dp2: 2px;
    --rm-space-dp20: 20px;
    --rm-space-dp24: 24px;
    --rm-space-dp32: 32px;
    --rm-space-dp4: 4px;
    --rm-space-dp40: 40px;
    --rm-space-dp48: 48px;
    --rm-space-dp6: 6px;
    --rm-space-dp8: 8px;
    --rm-state-connected: #69F0AE;
    --rm-state-connected-bg: rgba(76, 175, 80, 0.2);
    --rm-state-danger: #FF5252;
    --rm-state-danger-fill: #D32F2F;
    --rm-state-danger-text: #FF7272;
    --rm-state-off-target: #FF4444;
    --rm-state-off-target-hud: #FF625B;
    --rm-state-success: #06D6A0;
    --rm-state-warning: #FF9800;
    --rm-state-warning-bg: rgba(255, 152, 0, 0.15);
    --rm-step-cooldown: #118AB2;
    --rm-step-cooldown-hud: #37A2CB;
    --rm-step-rest: #06D6A0;
    --rm-step-rest-hud: #06D6A0;
    --rm-step-unknown: #607D8B;
    --rm-step-unknown-hud: #7D9BA9;
    --rm-step-warmup: #FFD166;
    --rm-step-warmup-hud: #FFD166;
    --rm-step-work: #EF476F;
    --rm-step-work-hud: #FF5D7F;
    --rm-stroke-accent: 3px;
    --rm-stroke-focus: 2px;
    --rm-stroke-focus-halo: 4px;
    --rm-stroke-hairline: 1px;
    --rm-stroke-selected: 2.5px;
    --rm-stroke-target: 1.5px;
    --rm-surface-card: #1A2E45;
    --rm-surface-nav: rgba(10, 22, 34, 0.92);
    --rm-surface-overlay: #1E3550;
    --rm-surface-raised: #23364C;
    --rm-text-disabled: rgba(255, 255, 255, 0.38);
    --rm-text-hud-primary: #FFFFFF;
    --rm-text-on-accent: #04131C;
    --rm-text-primary: #FFFFFF;
    --rm-text-secondary: rgba(255, 255, 255, 0.7);
    --rm-text-selection: rgba(0, 180, 216, 0.35);
    --rm-text-tertiary: rgba(255, 255, 255, 0.54);
    --rm-title-size: 20px;
    --rm-title-s-size: 16px;
    --rm-title-xs-size: 14px;
}
