# Unity
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.apk
*.aab
*.unitypackage
crashlytics-build.properties
.vs/
.idea/
*.csproj
!/tools/**/*.csproj
*.sln
!/tools/**/*.sln
# Unity 6.3 con com.unity.ide.visualstudio 2.0.28 genera <proyecto>.slnx en la raíz (primer open real, It. 2).
*.slnx
!/tools/**/*.slnx
*.user
*.userprefs

# dotnet (Core fuera de Unity)
/tools/**/bin/
/tools/**/obj/
/tools/**/TestResults/
/tools/dotnet/.artifacts/
# Resultados y logs de los tests dentro de Unity (tools/unity/run-unity-tests.ps1, QA-V-05).
/tools/unity/.artifacts/
# tools/oracle/bin/ son los scripts Dart del oráculo (fuentes), no una salida de compilación.
!/tools/oracle/bin/

# Oráculo Dart (tools/oracle): solo se versionan los scripts y el JSON dorado
/tools/oracle/.dart_tool/
/tools/oracle/pubspec.lock

# Oráculo del motor legacy (tools/oracle/engine, It. 4a): lo que dejan pub get y flutter test
/tools/oracle/engine/.dart_tool/
/tools/oracle/engine/build/
/tools/oracle/engine/.flutter-plugins*
/tools/oracle/engine/pubspec_overrides.yaml
/tools/oracle/engine/pubspec.lock

# Secretos (R-02, AC-APP-19-03, QA-V-02 de la It. 1). Ningún archivo propio puede llamarse StravaSecrets*,
# con CUALQUIER extensión (.cs, .json, .asset, .txt…) y su .meta (que empieza igual). Las clases de corchetes cubren
# las mayúsculas en Linux, donde git distingue; en Windows (core.ignorecase) ya no distingue.
# StravaSecrets.g.cs lo genera el build en Assets/RowMate/Bootstrap/Generated/ (ARCHITECTURE §11.1).
/Assets/RowMate/Bootstrap/Generated/
/Assets/RowMate/Bootstrap/Generated.meta
**/[Ss]trava[Ss]ecrets*
**/[Ss]trava_[Ss]ecrets*
**/strava.local.json*
*.keystore
*.jks
*.p12
*.mobileprovision
*.ulf

# Assets de terceros (Mixamo, Asset Store, Terrain Sample Asset Pack, CC0 opcionales).
# Ruta única: Assets/ThirdParty/ (ARCHITECTURE §2). Se usan en la app, no se redistribuyen.
# Se versionan solo los .meta, para conservar el GUID y los ajustes de importación que usan los asset slots.
/Assets/ThirdParty/**
!/Assets/ThirdParty/**/
!/Assets/ThirdParty/**/*.meta

# Unity.gitignore estándar (del commit inicial del repo remoto)
.utmp/
*.log
*.blend1
*.blend1.meta
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user
.gradle/
ExportedObj/
.consulo/
*.unityproj
*.suo
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
mono_crash.*
