# Normalización de fin de línea (ARCHITECTURE §2; R-T9: core.autocrlf=true en la PC de desarrollo).
* text=auto
*.cs text diff=csharp
*.json text eol=lf
*.uss text eol=lf
*.asmdef text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.dart text eol=lf
*.sh text eol=lf
# It. 12: el golden del TCX (Tests/Golden/tcx/T-1.tcx) se compara byte a byte con lo que arma la app, que escribe \n.
*.tcx text eol=lf
# It. 10a: el formato binario de los eventos BLE (Tests/Golden/ble/events-v1.bin), byte por byte.
*.bin binary

# Binarios propios con Git LFS (en la It. 1 no habia ninguno; la It. 2 suma los videos del arnes de capturas).
*.png filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.bundle filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
# It. 10a: el plugin de Bluetooth de Windows va SIN LFS (un clon sin LFS lo tiene igual; native/windows/build.ps1 -Check
# compara su SHA-256 con el que compila).
Assets/Plugins/Windows/x86_64/RowMateBle.dll -filter -diff -merge -text
# It. 14 (02-tech-design §2.2, QA-G14-16): el ícono generado por tools/icon y sus hojas CAP-01/CAP-02 van SIN LFS (son chicos;
# ci-core no baja LFS y AppIconAssetsAreCurrentTests los compara byte a byte).
Assets/RowMate/Art/Identity/**/*.png -filter -diff binary
docs/migration/iterations/14-pulido-plataformas/snapshots/CAP-0[12].png -filter -diff binary
